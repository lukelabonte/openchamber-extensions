{
  "name": "firstmate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/build",
    "test": "bun test tests/",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.5.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.2.0"
    },
    "contributes": {
      "capabilities": ["sessions", "shells"],
      "background": { "entry": "panel/background.html" },
      "commands": [
        { "name": "fm", "description": "Hand this request to this project's first mate" },
        { "name": "fm-bearings", "description": "Request FirstMate bearings; add file to save a report" },
        { "name": "fm-open", "description": "Open this project's first mate" }
      ],
      "actions": [
        { "id": "firstmate-open", "label": "Open FirstMate", "where": "session", "mode": "background" },
        { "id": "firstmate-bearings", "label": "FirstMate bearings", "where": "session", "mode": "background" },
        { "id": "firstmate-handoff", "label": "Hand to FirstMate", "where": "message", "roles": ["user"], "mode": "background" }
      ],
      "panel": {
        "id": "firstmate",
        "name": "FirstMate",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": ["openchamber", "git", "gh", "sh", "node"]
        }
      }
    }
  }
}
